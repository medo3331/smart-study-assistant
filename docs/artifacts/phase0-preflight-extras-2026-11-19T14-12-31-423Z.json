  "definitions": {
    "handle_signup_bonus()": "CREATE OR REPLACE FUNCTION public.handle_signup_bonus()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_catalog'\nAS $function$\r\ndeclare\r\n  v_amount int;\r\nbegin\r\n  -- استثناء الزائر المجهول — لا نمنح\r\n  if coalesce((auth.jwt() ->> 'is_anonymous')::boolean, false) then\r\n    return new;\r\n  end if;\r\n\r\n  select amount into v_amount from public.coin_source_rules where id = 'signup_bonus' and is_live = true;\r\n  if not found then return new; end if;\r\n\r\n  insert into public.coin_wallets (user_id) values (new.id) on conflict (user_id) do nothing;\r\n\r\n  insert into public.coin_ledger (user_id, source, amount, source_type, ref_id, metadata)\r\n  values (new.id, 'signup_bonus', v_amount, 'earn', new.id::text, jsonb_build_object('trigger', 'profile_insert'))\r\n  on conflict do nothing;\r\n\r\n  return new;\r\nend;\r\n$function$\n",
    "daily_missions()": "CREATE OR REPLACE FUNCTION public.daily_missions()\n RETURNS TABLE(mission text, label text, done boolean, claimed boolean, coins integer, xp integer)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_catalog'\nAS $function$\r\ndeclare v_uid uuid := auth.uid(); v_day date := public.cairo_day();\r\nbegin\r\n  if v_uid is null then raise exception 'daily_missions: لازم تكون داخل بحسابك'; end if;\r\n  return query\r\n  select m.id, m.label, m.done, exists(select 1 from public.daily_mission_claims c where c.user_id=v_uid and c.day=v_day and c.mission=m.id), 5, 10\r\n  from (\r\n    select 'study'::text id, 'أكمل خطوة مذاكرة'::text label, exists(select 1 from public.coin_ledger l where l.user_id=v_uid and l.source='day_done' and l.source_type='earn' and l.created_at >= (v_day::timestamp at time zone 'Africa/Cairo')) done\r\n    union all select 'goal', 'أنجز هدفًا في المخطط', exists(select 1 from public.coin_ledger l where l.user_id=v_uid and l.source='goal_done' and l.source_type='earn' and l.created_at >= (v_day::timestamp at time zone 'Africa/Cairo'))\r\n    union all select 'riddle', 'حل فزورة البريك', exists(select 1 from public.break_riddle_sessions s where s.user_id=v_uid and s.day=v_day and s.solved_at is not null)\r\n    union all select 'game', 'أكمل لعبة بريك', exists(select 1 from public.break_game_claims g where g.user_id=v_uid and g.day=v_day)\r\n  ) m;\r\nend; $function$\n",
    "weekly_missions()": "CREATE OR REPLACE FUNCTION public.weekly_missions()\n RETURNS TABLE(id text, label text, week_key text, steps_target integer, days_target integer, steps_done integer, days_done integer, done boolean, claimed boolean, coins integer, xp integer, ends_on date)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_catalog'\nAS $function$\r\ndeclare\r\n  v_uid    uuid := auth.uid();\r\n  v_week   text := public.current_quiz_week();\r\n  v_start  date := public.current_quiz_week()::date;\r\n  v_ends   date := (public.current_quiz_week()::date + 6);\r\n  v_steps  int := 0;\r\n  v_days   int := 0;\r\n  c_steps  constant int := 5;\r\n  c_days   constant int := 3;\r\n  c_coins  constant int := 150;\r\n  c_xp     constant int := 120;\r\nbegin\r\n  if v_uid is null then\r\n    raise exception 'weekly_missions: لازم تكون داخل بحسابك';\r\n  end if;\r\n\r\n  select count(*) into v_steps\r\n    from public.coin_ledger l\r\n   where l.user_id = v_uid\r\n     and l.source = 'day_done'\r\n     and l.source_type = 'earn'\r\n     and l.created_at >= (v_start::timestamp at time zone 'Africa/Cairo')\r\n     and l.created_at <  ((v_start + 7)::timestamp at time zone 'Africa/Cairo');\r\n\r\n  select count(distinct (l.created_at at time zone 'Africa/Cairo')::date) into v_days\r\n    from public.coin_ledger l\r\n   where l.user_id = v_uid\r\n     and l.source in ('day_done', 'goal_done')\r\n     and l.source_type = 'earn'\r\n     and l.created_at >= (v_start::timestamp at time zone 'Africa/Cairo')\r\n     and l.created_at <  ((v_start + 7)::timestamp at time zone 'Africa/Cairo');\r\n\r\n  return query\r\n  select 'weekly'::text,\r\n         'أكمل ٥ مراحل وذاكر ٣ أيام'::text,\r\n         v_week,\r\n         c_steps,\r\n         c_days,\r\n         v_steps,\r\n         v_days,\r\n         (v_steps >= c_steps and v_days >= c_days),\r\n         exists (\r\n           select 1 from public.weekly_mission_claims w\r\n            where w.user_id = v_uid and w.week_key = v_week\r\n         ),\r\n         c_coins,\r\n         c_xp,\r\n         v_ends;\r\nend;\r\n$function$\n",
    "_streak_apply(uuid)": "CREATE OR REPLACE FUNCTION public._streak_apply(p_uid uuid)\n RETURNS TABLE(streak integer, grew boolean, last_study_day date)\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public', 'pg_catalog'\nAS $function$\r\ndeclare\r\n  v_today  date := public.cairo_day();\r\n  v_streak int;\r\n  v_last   date;\r\n  v_new    int;\r\n  v_bonus_xp int := 0;\r\nbegin\r\n  if p_uid is null then\r\n    raise exception '_streak_apply: p_uid required';\r\n  end if;\r\n\r\n  select coalesce(p.streak, 0), p.last_study_day\r\n    into v_streak, v_last\r\n    from public.profiles p\r\n   where p.id = p_uid\r\n   for update;\r\n\r\n  if not found then\r\n    raise exception '_streak_apply: profile not found';\r\n  end if;\r\n\r\n  if v_last is not null and v_last >= v_today then\r\n    return query select v_streak, false, v_last;\r\n    return;\r\n  end if;\r\n\r\n  if v_last is not null and v_last = v_today - 1 then\r\n    v_new := greatest(coalesce(v_streak, 0), 0) + 1;\r\n  else\r\n    v_new := 1;\r\n  end if;\r\n\r\n  perform set_config('app.streak_bypass', 'on', true);\r\n  update public.profiles\r\n     set streak = v_new,\r\n         last_study_day = v_today\r\n   where id = p_uid;\r\n  perform set_config('app.streak_bypass', 'off', true);\r\n\r\n  /* ── مكافآت اليوم (زي db/43) ── */\r\n  if v_new >= 2 then\r\n    begin\r\n      perform public.award_coins('streak_day', v_today::text);\r\n    exception when others then\r\n      null;\r\n    end;\r\n  end if;\r\n\r\n  /* ── محطات السلسلة (Phase 2) ──\r\n     Coins من جدول القواعد عبر award_coins، وXP هنا مباشرة.\r\n     كل حاجة ملفوفة في begin/exception: مصدر لسه مش مهيّأ مايكسرش تسجيل اليوم. */\r\n  if v_new % 3 = 0 then\r\n    begin\r\n      perform public.award_coins('streak_tier_3', v_today::text);\r\n    exception when others then\r\n      null;\r\n    end;\r\n    v_bonus_xp := v_bonus_xp + 15;\r\n  end if;\r\n\r\n  if v_new % 7 = 0 then\r\n    begin\r\n      perform public.award_coins('perfect_week', v_today::text);\r\n    exception when others then\r\n      null;\r\n    end;\r\n    v_bonus_xp := v_bonus_xp + 50;\r\n  end if;\r\n\r\n  if v_new % 30 = 0 then\r\n    begin\r\n      perform public.award_coins('streak_tier_30', v_today::text);\r\n    exception when others then\r\n      null;\r\n    end;\r\n    v_bonus_xp := v_bonus_xp + 200;\r\n  end if;\r\n\r\n  if v_bonus_xp > 0 then\r\n    perform set_config('app.xp_bypass', 'on', true);\r\n    update public.profiles\r\n       set xp = greatest(0, coalesce(xp, 0) + v_bonus_xp)\r\n     where id = p_uid;\r\n    perform set_config('app.xp_bypass', 'off', true);\r\n  end if;\r\n\r\n  return query select v_new, true, v_today;\r\nend;\r\n$function$\n"
