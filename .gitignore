# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

/app/generated/prisma

# local database
*.db
*.db-journal

# old redesign snapshot (duplicate of app/, contains copies of the API routes)
/.redesign-backup/

# editor / tooling local state
/.vscode/
/.windsurf/

# الاستثناء الوحيد: نسخة التوثيق من غير قيم.
# لازم تفضل بعد كل قواعد .env* عشان تغلبهم.
!.env.example
