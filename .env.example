# نسخة للتوثيق بس — مفيش أي قيمة حقيقية هنا.
# انسخه لـ .env.local وحُط القيم، والأهم: ظبّطهم كمان في
# Vercel → Settings → Environment Variables، لأن .gitignore
# بيستثني .env* فالمفاتيح المحلية عمرها ما بتوصل للنشر.
# ⚠️ أي متغير جديد بتضيفه لازم يتعمل redeploy بعده — Vercel
# مش بيحقن متغيرات جديدة في نشرة قديمة.

# --- Supabase (الحساب والداتا) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Groq (الشات وتوليد الخطة) ---
# GROQ_API_KEY هو الأساسي. المرقّمين اختياريين وبيستخدموا
# للتبديل بين المفاتيح في /api/generate-plan لما الكوتة تخلص.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# --- Gemini (التحليل المتخصص) ---
# Server-side فقط: لا تستخدم NEXT_PUBLIC_ ولا تضعه في أي Client Component.
GEMINI_API_KEY=

# --- ocr.space (قراءة النص من الصور في /api/analyze-file) ---
# من غيره تحليل الصور بيرجع 503 "تحليل الصور غير متاح حالياً".
# ⚠️ الخطة المجانية بترفض أي صورة أكبر من ١ ميجا عن طريق الـ API
# (الـ ٥ ميجا المكتوبة على موقعهم بتاعة الرفع اليدوي بس).
OCR_SPACE_API_KEY=

# --- Web Push (الإشعارات) ---
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- الدومين (لصور الـ OG والميتاداتا) ---
# لو فاضي بيرجع لـ VERCEL_URL اللي Vercel بيحقنه لوحده，
# وبعدين localhost. ظبّطه في الإنتاج عشان صور المشاركة تطلع صح.
NEXT_PUBLIC_SITE_URL=

# --- Resend (آراء المستخدمين 👍👎 بتوصلك إيميل) ---
# مفتاح من resend.com/api-keys. من غيره الودجت بيشتغل عادي والرأي
# بيتسجّل في اللوجز بس (Vercel → Logs) — يعني مش بيضيع، بس مش
# هيوصلك إيميل. ابحث عن "feedback:" في اللوجز.
RESEND_API_KEY=
# الإيميل اللي الآراء توصله. لازم يتحط عشان الإرسال يشتغل.
FEEDBACK_EMAIL_TO=
# المُرسِل. سيبه فاضي = onboarding@resend.dev (شغّال من غير دومين
# متحقّق). لو عندك دومين متحقّق في Resend حطه هنا: مثلاً no-reply@site.com
FEEDBACK_EMAIL_FROM=

# --- دعوة الجروب (ديسكورد/واتساب/تليجرام) ---
# ⚠️ لو فاضي البانر مابيظهرش خالص — وده مقصود. بانر دعوة بيودّي
# على لينك ميت أسوأ من مفيش بانر. حطّ اللينك → البانر يظهر لوحده
# في الداشبورد وصفحة المجتمع.
# ⚠️ NEXT_PUBLIC_* بتتحقن وقت البيلد، فلازم redeploy بعد ما تحطه.
NEXT_PUBLIC_DISCORD_INVITE=

# --- دعم واتساب ---
# رابط واتساب كامل بصيغة https://wa.me/201xxxxxxxxx . لو سيبته فاضي
# هيستخدم نفس رابط التواصل الافتراضي في الموقع.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
