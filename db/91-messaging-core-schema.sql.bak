-- ===========================================================================
-- MAGICLY — MESSAGING CORE — Schema migration
-- ===========================================================================
-- Entities: conversations, conversation_participants, messages,
--           message_attachments, message_state, message_reports, user_blocks,
--           announcement_references
--
-- Idempotent: safe to run more than once.
-- NOTE: This file is a design reference. Apply to development Supabase
-- project only — no production data changes.
-- ===========================================================================

-- ----------------------------------------------------------------------------
-- 1. conversations
-- ----------------------------------------------------------------------------
create table if not exists public.conversations (
  id         uuid primary key default gen_random_uuid(),
  title      text not null default 'محادثة جديدة',
  status     text not null default 'active'
    check (status in ('active', 'archived', 'closed', 'deleted')),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create index if not exists idx_conversations_status
  on public.conversations (status, created_at desc);

create index if not exists idx_conversations_updated
  on public.conversations (updated_at desc);

-- ----------------------------------------------------------------------------
-- 2. conversation_participants
-- ----------------------------------------------------------------------------
create table if not exists public.conversation_participants (
  conversation_id uuid not null
    references public.conversations (id) on delete cascade,
  participant_id  uuid not null
    references auth.users (id) on delete cascade,
  role            text not null default 'member'
    check (role in ('member', 'owner', 'moderator', 'admin')),
  is_archived     boolean not null default false,
  is_muted        boolean not null default false,
  last_read_msg_id uuid, -- pointer to last read message (for read receipts)
  last_read_at    timestamptz,
  joined_at       timestamptz not null default now(),
  blocked_by      uuid references auth.users (id) on delete set null,
  primary key (conversation_id, participant_id)
);

create index if not exists idx_participants_conversation
  on public.conversation_participants (conversation_id);

create index if not exists idx_participants_participant
  on public.conversation_participants (participant_id);

create index if not exists idx_participants_role_status
  on public.conversation_participants (conversation_id, role, is_archived);

-- Unique index to ensure one participant row per conversation-user pair
create unique index if not exists uq_participants_conversation_user
  on public.conversation_participants (conversation_id, participant_id);

-- ----------------------------------------------------------------------------
-- 3. messages
-- ----------------------------------------------------------------------------
create table if not exists public.messages (
  id            uuid primary key default gen_random_uuid(),
  conversation_id uuid not null
    references public.conversations (id) on delete cascade,
  sender_id     uuid not null
    references auth.users (id) on delete cascade,
  body          text not null,
  is_deleted    boolean not null default false, -- soft delete (sender-side)
  created_at    timestamptz not null default now(),
  updated_at    timestamptz not null default now()
);

create index if not exists idx_messages_conversation
  on public.messages (conversation_id, created_at desc);

create index if not exists idx_messages_sender
  on public.messages (sender_id, created_at desc);

-- Check: only participants of the conversation can be sender
-- (enforced by application logic + RLS, this is a soft guard)
create policy "messages: insert from authorized sender"
  on public.messages for insert
  with check (
    sender_id = auth.uid()
    and exists (
      select 1 from public.conversation_participants cp
      where cp.conversation_id = messages.conversation_id
        and cp.participant_id = auth.uid()
    )
  );

create policy "messages: read via conversation membership"
  on public.messages for select
  using (
    exists (
      select 1 from public.conversation_participants cp
      where cp.conversation_id = messages.conversation_id
        and cp.participant_id = auth.uid()
    )
  );

create policy "messages: delete own soft"
  on public.messages for delete
  using (sender_id = auth.uid());
